# -----------------
# Project Artifacts / Machine Learning
# -----------------
# Ignore model checkpoints and weights
models/*
!models/.gitkeep

# Ignore training runs, logs, and wandb artifacts
runs/*
!runs/.gitkeep
wandb/
*.log

# Ignore data files (jsonl, csv, etc.) to prevent committing large datasets
data/*
!data/.gitkeep

# Ignore results/metrics outputs
results/*
!results/.gitkeep

